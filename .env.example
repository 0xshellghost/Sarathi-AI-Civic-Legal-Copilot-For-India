# ==============================================================================
# SARATHI Civic & Legal AI Copilot - Environment Configuration
# ==============================================================================

# Sarvam AI - High-fidelity Indic Speech-to-Text, Studio Text-to-Speech & Translation
# Powers native Indian language speech synthesis (bulbul:v3), ASR (saaras:v4), and Mayura translation
SARVAM_API_KEY="YOUR_SARVAM_API_KEY"
SARVAM_TTS_MODEL="bulbul:v3"
SARVAM_STT_MODEL="saaras:v4"
SARVAM_TTS_DEFAULT_SPEAKER="priya"

# Primary AI Provider (Gemini 3.1 Flash Lite / 3.7 Flash)
GEMINI_API_KEY="YOUR_GEMINI_API_KEY"

# Secondary AI Provider (OpenRouter Fallback Chain)
OPENROUTER_API_KEY="YOUR_OPENROUTER_API_KEY"

# Speech-to-Text Provider (Groq Whisper - whisper-large-v3)
GROQ_API_KEY="YOUR_GROQ_API_KEY"

# Optional: Configurable OpenRouter fallback models (comma-separated cascade)
# Default: meta-llama/llama-3.3-70b-instruct,mistralai/mistral-small-24b-instruct-2501,qwen/qwen-2.5-72b-instruct
OPENROUTER_MODELS="meta-llama/llama-3.3-70b-instruct,mistralai/mistral-small-24b-instruct-2501,qwen/qwen-2.5-72b-instruct"
