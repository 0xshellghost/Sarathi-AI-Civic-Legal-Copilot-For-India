rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /cases/{userId}/{caseId}/{allPaths=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    match /temp_uploads/{userId}/{allPaths=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
