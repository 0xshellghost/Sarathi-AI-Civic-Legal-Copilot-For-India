rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global Auth & Identity Helpers
    function isSignedIn() {
      return request.auth != null && request.auth.uid != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Default catch-all rule: Deny all by default
    match /{document=**} {
      allow read, write: if false;
    }

    // Citizen User Profiles (Private, scoped to authenticated user)
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow list: if false;
      allow create: if isOwner(userId) && request.resource.data.uid == userId;
      allow update: if isOwner(userId) && (!('uid' in request.resource.data) || request.resource.data.uid == userId);
      allow delete: if false;
    }

    // Sources collection (Publicly readable authoritative civic knowledge base)
    match /sources/{sourceId} {
      allow read: if true;
      allow write: if false;
    }

    // Knowledge Chunks (Publicly readable vectorized civic guidelines)
    match /chunks/{chunkId} {
      allow read: if true;
      allow write: if false;
    }

    // Welfare Schemes (Publicly readable welfare scheme eligibility rules)
    match /schemes/{schemeId} {
      allow read: if true;
      allow write: if false;
    }

    // Public Authorities Directory (Publicly readable)
    match /authorities/{authorityId} {
      allow read: if true;
      allow write: if false;
    }

    // Citizen Cases - scoped strictly to authenticated owner by request.auth.uid == userId
    match /cases/{caseId} {
      allow get: if isOwner(resource.data.userId);
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update: if isOwner(resource.data.userId) && request.resource.data.userId == resource.data.userId;
      allow delete: if isOwner(resource.data.userId);
    }

    // Feedback collection - Authenticated user submissions for their own cases
    match /feedback/{feedbackId} {
      allow create: if isSignedIn() && (
        !('userId' in request.resource.data) || request.resource.data.userId == request.auth.uid
      );
      allow read: if false;
      allow update, delete: if false;
    }

    // Uploaded Documents Metadata - scoped strictly to authenticated owner
    match /uploadedDocuments/{docId} {
      allow get: if isOwner(resource.data.userId);
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update: if isOwner(resource.data.userId) && request.resource.data.userId == resource.data.userId;
      allow delete: if isOwner(resource.data.userId);
    }
  }
}
